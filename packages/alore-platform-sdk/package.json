{
  "name": "@alore/platform-sdk",
  "version": "0.1.0-alpha.1",
  "description": "Thin typed TypeScript layer over the official openai SDK for the Alore /ai/v1 API",
  "repository": "https://github.com/0xCarbon/alore-js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run build && rm -rf build && tsc -p tsconfig.test.json && node --test build/test/*.test.js"
  },
  "author": "0xCarbon",
  "license": "LGPL-2.1-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "peerDependencies": {
    "openai": "^4.93.0 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@alore/platform-contract": "workspace:*",
    "@types/node": "20.4.8",
    "openai": "4.93.0",
    "typescript": "5.4.5"
  }
}
